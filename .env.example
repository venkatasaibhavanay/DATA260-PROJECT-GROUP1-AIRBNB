# =============================================================================
# DATA 260 Group 1 Airbnb — environment template
# Copy to .env with:  ./scripts/setup-env.sh   (generates random local passwords)
# .env is git-ignored. Never commit real credentials.
# =============================================================================

COMPOSE_PROJECT_NAME=data260-group1
APP_ENV=development

# ---- Application ports (Group 1 convention: end in 1) ----------------------
FRONTEND_PORT=5101
USER_SERVICE_PORT=8101
PROPERTY_SERVICE_PORT=8111
BOOKING_SERVICE_PORT=8121
MESSAGING_REVIEW_SERVICE_PORT=8131
AI_SERVICE_PORT=8141
ANALYTICS_SERVICE_PORT=8151

# Origins allowed by backend CORS (comma-separated)
CORS_ORIGINS=http://localhost:5101,http://127.0.0.1:5101

# ---- Frontend → backend API addresses (Vite exposes only VITE_* vars) ------
VITE_USER_API_URL=http://localhost:8101
VITE_PROPERTY_API_URL=http://localhost:8111
VITE_BOOKING_API_URL=http://localhost:8121
VITE_MESSAGING_API_URL=http://localhost:8131
VITE_AI_API_URL=http://localhost:8141
VITE_ANALYTICS_API_URL=http://localhost:8151

# ---- Docker host ports (bound to 127.0.0.1 only) ---------------------------
MYSQL_HOST_PORT=3311
MONGO_HOST_PORT=27101
REDIS_HOST_PORT=6381
KAFKA_HOST_PORT=9091

# ---- Connection settings for services running on YOUR LAPTOP (host) --------
# Inside the Docker network use instead:
#   MYSQL_HOST=mysql MYSQL_PORT=3306  MONGO_HOST=mongodb MONGO_PORT=27017
#   REDIS_HOST=redis REDIS_PORT=6379  KAFKA_BOOTSTRAP_SERVERS=kafka:29092
MYSQL_HOST=localhost
MYSQL_PORT=3311
MYSQL_DATABASE=airbnb_group1
MYSQL_USER=group1_app
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me

MONGO_HOST=localhost
MONGO_PORT=27101
MONGO_DATABASE=airbnb_group1
MONGO_ROOT_USER=group1_admin
MONGO_ROOT_PASSWORD=change_me

REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=change_me

KAFKA_BOOTSTRAP_SERVERS=localhost:9091
